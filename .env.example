# ============================================================
# FIREBASE CONFIGURATION (dùng cho Firestore Database)
# Lấy từ Firebase Console > Project Settings > Your apps
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# SUPABASE STORAGE (chỉ dùng để lưu ảnh sản phẩm)
# Hướng dẫn:
# 1. Đăng ký miễn phí tại https://supabase.com
# 2. Tạo project mới (hoặc dùng project có sẵn)
# 3. Vào Settings > API để lấy:
#    - "Project URL"  → VITE_SUPABASE_URL
#    - "anon public"  → VITE_SUPABASE_ANON_KEY
# 4. Vào Storage > New bucket:
#    - Tên bucket: shop-images
#    - Bật "Public bucket"
# 5. Vào Storage > Policies > New policy:
#    - Chọn "For full customization"
#    - Allowed operations: INSERT, SELECT
#    - Target roles: anon, authenticated
# ============================================================
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# TELEGRAM BOT NOTIFICATION
# Hướng dẫn:
# 1. Nhắn @BotFather trên Telegram, gõ /newbot để tạo bot
# 2. Lấy TOKEN từ BotFather
# 3. Nhắn tin cho bot, rồi vào: https://api.telegram.org/bot<TOKEN>/getUpdates
#    để lấy chat_id (tìm "id" trong "chat" object)
# ============================================================
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# ============================================================
# EMAIL NOTIFICATION (dùng EmailJS - miễn phí 200 email/tháng)
# Hướng dẫn:
# 1. Đăng ký tại https://www.emailjs.com/
# 2. Tạo Email Service (kết nối Gmail)
# 3. Tạo Email Template với các biến: {{to_email}}, {{order_id}},
#    {{product_name}}, {{full_name}}, {{total_price}}, {{contact}},
#    {{payment_method}}, {{order_time}}
# 4. Lấy Service ID, Template ID, Public Key từ dashboard
# ============================================================
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Danh sách email nhận thông báo, cách nhau bằng dấu phẩy
VITE_NOTIFY_EMAILS=your_email@gmail.com,another_email@gmail.com
